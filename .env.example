# Copie este arquivo para .env.local e preencha com os valores reais.
# Pegue a connection string em: https://supabase.com/dashboard/project/jtexbzfkbwpulisqvaia/settings/database
# Use o modo "Transaction" (porta 6543, pgbouncer=true) para DATABASE_URL
# e o modo "Session"/direto (porta 5432) para DIRECT_URL (necessário para `prisma migrate`).
DATABASE_URL="postgresql://postgres.jtexbzfkbwpulisqvaia:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jtexbzfkbwpulisqvaia.supabase.co:5432/postgres"

# Opcional — se definido, os relatórios de IA usam a API real da OpenAI (gpt-4o-mini).
# Sem esta chave, o sistema usa um gerador mock para manter o fluxo funcional.
OPENAI_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
