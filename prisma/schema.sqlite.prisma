generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OffboardingStatus {
  AI_CAPTURE
  IT_ACTION
  COMPLETED
  CANCELLED
}

enum AssetType {
  NOTEBOOK
  MONITOR
  PERIPHERAL
  BADGE
}

enum AssetStatus {
  PENDING_RETURN
  RETURNED
  DAMAGED
}

enum KnowledgeStatus {
  DRAFT
  PROCESSING
  READY
  APPROVED
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  MICROSOFT_ENTRA
  SLACK
  GITHUB
  OKTA
  NOTION
  FIGMA
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
}

enum LogStatus {
  SUCCESS
  ERROR
}

enum FiscalDocumentType {
  INCOME_REPORT
  PAYSLIP
}

enum LegalTermType {
  AVISO_PREVIO
  TERMO_QUITACAO
}

enum LegalTermStatus {
  PENDING
  SIGNED
  REJECTED
}

enum HRRequestType {
  RECOMMENDATION_LETTER
  GENERAL_QUESTION
}

enum HRRequestStatus {
  OPEN
  RESOLVED
}

model OffboardingSession {
  id           String            @id @default(cuid())
  employeeName String
  email        String
  cpf          String?
  role         String
  department   String
  exitDate     DateTime
  status       OffboardingStatus @default(AI_CAPTURE)
  anonymizedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  interviewToken    InterviewToken?
  interviewResponse ExitInterviewResponse?
  knowledgeDocument KnowledgeDocument?
  assets            Asset[]
  tasks             PendingTask[]
  accessRevocations AccessRevocation[]
  exPortalAccess    ExPortalAccess?
  fiscalDocuments   FiscalDocument[]
  legalTerms        LegalTerm[]
  hrRequests        HRRequest[]
  auditLogs         AuditLog[]
}

model InterviewToken {
  id                   String             @id @default(cuid())
  token                String             @unique @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)
  used                 Boolean            @default(false)
  expiresAt            DateTime
  createdAt            DateTime           @default(now())
}

/// Questionário dinâmico por departamento (Gestão de Templates).
model InterviewTemplate {
  id         String   @id @default(cuid())
  department String   @unique
  title      String
  /// TemplateStep[] — ver lib/interview-template.ts
  steps      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExitInterviewResponse {
  id                   String             @id @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  /// Snapshot do template (steps/perguntas) exatamente como usado nesta entrevista.
  templateSnapshot Json
  /// Respostas digitadas, mapeadas por questionId -> texto.
  answers          Json
  /// Transcrição consolidada das notas de voz gravadas (Whisper), por passo.
  voiceTranscript  String?

  submittedAt DateTime @default(now())
}

model KnowledgeDocument {
  id                   String             @id @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  title           String
  department      String
  markdownContent String         
  status          KnowledgeStatus @default(DRAFT)
  generatedAt     DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvedAt      DateTime?
}

model Asset {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type         AssetType
  serialNumber String
  status       AssetStatus @default(PENDING_RETURN)
  notes        String?    
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())
}

model PendingTask {
  id                   String              @id @default(cuid())
  offboardingSessionId String?
  offboardingSession   OffboardingSession? @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  title       String
  description String
  urgent      Boolean  @default(false)
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Integration {
  id           String              @id @default(cuid())
  provider     IntegrationProvider @unique
  status       IntegrationStatus   @default(PENDING)
  config       Json?
  lastTestedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  logs IntegrationLog[]
}

model IntegrationLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  action     String
  targetUser String
  status     LogStatus
  statusCode Int
  message    String
  createdAt  DateTime  @default(now())
}

model AccessRevocation {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  provider  IntegrationProvider
  revoked   Boolean             @default(false)
  revokedAt DateTime?
  createdAt DateTime            @default(now())
}

/// Acesso permanente (self-service) do ex-colaborador ao seu próprio portal.
model ExPortalAccess {
  id                   String             @id @default(cuid())
  accessToken          String             @unique @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FiscalDocument {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type       FiscalDocumentType
  title      String
  year       Int?
  fileName   String
  mimeType   String
  content    Bytes
  uploadedAt DateTime           @default(now())
}

model LegalTerm {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type            LegalTermType
  title           String
  content         String         
  status          LegalTermStatus @default(PENDING)
  signerName      String?
  signerIp        String?
  signedAt        DateTime?
  rejectedAt      DateTime?
  rejectionReason String?        
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model HRRequest {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type       HRRequestType
  message    String         
  status     HRRequestStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?
}

/// Trilha de auditoria imutável — nunca é editada ou apagada pela aplicação.
model AuditLog {
  id                   String              @id @default(cuid())
  offboardingSessionId String?
  offboardingSession   OffboardingSession? @relation(fields: [offboardingSessionId], references: [id], onDelete: SetNull)

  actor       String
  action      String
  targetLabel String
  ipAddress   String?
  details     String? 
  createdAt   DateTime @default(now())

  @@index([offboardingSessionId])
}
