generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OffboardingStatus {
  AI_CAPTURE
  IT_ACTION
  COMPLETED
  CANCELLED
}

enum AssetType {
  NOTEBOOK
  MONITOR
  PERIPHERAL
  BADGE
}

enum AssetStatus {
  PENDING_RETURN
  RETURNED
  DAMAGED
}

enum KnowledgeStatus {
  DRAFT
  PROCESSING
  READY
  APPROVED
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  MICROSOFT_ENTRA
  SLACK
  GITHUB
  OKTA
  NOTION
  FIGMA
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
}

enum LogStatus {
  SUCCESS
  ERROR
}

enum FiscalDocumentType {
  INCOME_REPORT
  PAYSLIP
}

enum LegalTermType {
  AVISO_PREVIO
  TERMO_QUITACAO
}

enum LegalTermStatus {
  PENDING
  SIGNED
  REJECTED
}

enum HRRequestType {
  RECOMMENDATION_LETTER
  GENERAL_QUESTION
}

enum HRRequestStatus {
  OPEN
  RESOLVED
}

enum UserRole {
  ADMIN
  IT_ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum AssetLogisticsMethod {
  SHIPPING_LABEL
  PICKUP_SCHEDULE
}

enum AssetProtocolStatus {
  DRAFT
  SIGNED
}

/// Empresa cliente (tenant). Todo dado operacional pertence a uma Organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  offboardingSessions OffboardingSession[]
  integrations        Integration[]
  interviewTemplates  InterviewTemplate[]
  auditLogs           AuditLog[]
  assets              Asset[]
}

/// Usuário interno (RH/TI/Admin) — autenticado via NextAuth.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Hash bcrypt — nulo para usuários que só entram via OAuth.
  passwordHash  String?
  role          UserRole  @default(EMPLOYEE)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

/// Contas OAuth vinculadas (Google, Microsoft) — padrão do adapter do NextAuth.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Sessões de banco (usadas para linkagem OAuth do adapter; login por
/// credenciais usa estratégia JWT, sem depender desta tabela).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OffboardingSession {
  id           String            @id @default(cuid())
  orgId        String
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeName String
  email        String
  cpf          String?
  role         String
  department   String
  exitDate     DateTime
  status       OffboardingStatus @default(AI_CAPTURE)
  anonymizedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  interviewToken    InterviewToken?
  interviewResponse ExitInterviewResponse?
  knowledgeDocument KnowledgeDocument?
  assets            Asset[]
  tasks             PendingTask[]
  accessRevocations AccessRevocation[]
  exPortalAccess    ExPortalAccess?
  fiscalDocuments   FiscalDocument[]
  legalTerms        LegalTerm[]
  hrRequests        HRRequest[]
  auditLogs         AuditLog[]

  @@index([orgId, status])
  @@index([orgId, exitDate])
  @@index([orgId, department])
  @@index([orgId, createdAt])
}

model InterviewToken {
  id                   String             @id @default(cuid())
  token                String             @unique @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)
  used                 Boolean            @default(false)
  expiresAt            DateTime
  createdAt            DateTime           @default(now())
}

/// Questionário dinâmico por departamento (Gestão de Templates).
model InterviewTemplate {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department String
  title      String
  /// TemplateStep[] — ver lib/interview-template.ts
  steps      Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, department])
}

model ExitInterviewResponse {
  id                   String             @id @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  /// Snapshot do template (steps/perguntas) exatamente como usado nesta entrevista.
  templateSnapshot Json
  /// Respostas digitadas, mapeadas por questionId -> texto.
  answers          Json
  /// Transcrição consolidada das notas de voz gravadas (Whisper), por passo.
  voiceTranscript  String? @db.Text

  submittedAt DateTime @default(now())
}

model KnowledgeDocument {
  id                   String             @id @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  title           String
  department      String
  markdownContent String          @db.Text
  status          KnowledgeStatus @default(DRAFT)
  generatedAt     DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvedAt      DateTime?

  @@index([status])
}

model Asset {
  id                   String             @id @default(cuid())
  /// Denormalizado a partir de offboardingSession.orgId — isolamento multi-tenant
  /// direto, em defesa de profundidade além do filtro via relação.
  orgId                String
  org                  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type         AssetType
  serialNumber String
  status       AssetStatus @default(PENDING_RETURN)
  notes        String?     @db.Text
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  // --- Logística reversa -------------------------------------------------
  logisticsMethod   AssetLogisticsMethod?
  /// Código de rastreio (Correios/transportadora), quando o método é postagem.
  trackingCode      String?
  carrier           String?
  /// Endereço e data/hora combinados para coleta na casa do colaborador.
  pickupAddress     String?               @db.Text
  pickupScheduledAt DateTime?

  photos   AssetPhoto[]
  protocol AssetReturnProtocol?

  @@index([orgId])
  @@index([offboardingSessionId])
  @@index([status])
}

/// Registro fotográfico da conferência de danos feita pelo time de TI.
model AssetPhoto {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  imageData  Bytes
  mimeType   String
  fileName   String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([assetId])
}

/// Protocolo de conferência assinado pelo time de TI — base para
/// amortização/quitação patrimonial em caso de avaria.
model AssetReturnProtocol {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  content            String              @db.Text
  hasDamage          Boolean             @default(false)
  amortizationAmount Float?
  status             AssetProtocolStatus @default(DRAFT)
  signerName         String?
  signerIp           String?
  signedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model PendingTask {
  id                   String              @id @default(cuid())
  offboardingSessionId String?
  offboardingSession   OffboardingSession? @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  title       String
  description String
  urgent      Boolean  @default(false)
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([offboardingSessionId])
}

model Integration {
  id           String              @id @default(cuid())
  orgId        String
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  status       IntegrationStatus   @default(PENDING)
  config       Json?
  lastTestedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  logs IntegrationLog[]

  @@unique([orgId, provider])
}

model IntegrationLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  action     String
  targetUser String
  status     LogStatus
  statusCode Int
  message    String
  createdAt  DateTime  @default(now())

  @@index([integrationId])
  @@index([createdAt])
}

model AccessRevocation {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  provider  IntegrationProvider
  revoked   Boolean             @default(false)
  revokedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([offboardingSessionId, revoked])
}

/// Acesso permanente (self-service) do ex-colaborador ao seu próprio portal.
model ExPortalAccess {
  id                   String             @id @default(cuid())
  accessToken          String             @unique @default(cuid())
  offboardingSessionId String             @unique
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FiscalDocument {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type       FiscalDocumentType
  title      String
  year       Int?
  fileName   String
  mimeType   String
  content    Bytes
  uploadedAt DateTime           @default(now())

  @@index([offboardingSessionId])
}

model LegalTerm {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type            LegalTermType
  title           String
  content         String          @db.Text
  status          LegalTermStatus @default(PENDING)
  signerName      String?
  signerIp        String?
  signedAt        DateTime?
  rejectedAt      DateTime?
  rejectionReason String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([offboardingSessionId])
  @@index([status])
}

model HRRequest {
  id                   String             @id @default(cuid())
  offboardingSessionId String
  offboardingSession   OffboardingSession @relation(fields: [offboardingSessionId], references: [id], onDelete: Cascade)

  type       HRRequestType
  message    String          @db.Text
  status     HRRequestStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([offboardingSessionId])
  @@index([status])
}

/// Trilha de auditoria imutável — nunca é editada ou apagada pela aplicação.
model AuditLog {
  id                   String              @id @default(cuid())
  orgId                String
  org                  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  offboardingSessionId String?
  offboardingSession   OffboardingSession? @relation(fields: [offboardingSessionId], references: [id], onDelete: SetNull)

  actor       String
  action      String
  targetLabel String
  ipAddress   String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([offboardingSessionId])
  @@index([orgId, createdAt])
}
